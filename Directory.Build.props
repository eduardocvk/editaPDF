<Project><PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><RuntimeIdentifiers>win-x64</RuntimeIdentifiers><RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion><TargetLatestRuntimePatch>false</TargetLatestRuntimePatch><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><NuGetAudit>false</NuGetAudit><Deterministic>true</Deterministic><Product>Editor PDF</Product><Version>0.7.0</Version><PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression></PropertyGroup>
<ItemGroup><None Include="$(MSBuildThisFileDirectory)assets\fonts\**" Link="assets\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><None Include="$(MSBuildThisFileDirectory)vendor\bin\pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><None Include="$(MSBuildThisFileDirectory)vendor\licenses\**" Link="licenses\pdfium\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><None Include="$(MSBuildThisFileDirectory)vendor\LICENSE" Link="licenses\pdfium-binaries.txt" CopyToOutputDirectory="PreserveNewest"/><None Include="$(MSBuildThisFileDirectory)licenses\**" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/><None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest"/><None Include="$(MSBuildThisFileDirectory)NOTICE.txt" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest"/><None Include="$(MSBuildThisFileDirectory)assets\*" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/></ItemGroup></Project>
