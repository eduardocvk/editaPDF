<Window x:Class="EditorPdf.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EditorPdf.App" Title="Editor PDF" Width="1280" Height="850" MinWidth="920" MinHeight="620" Background="#F3F5F8" Foreground="#203047" FontSize="13" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="KeysPressed" Closing="WindowClosing">

<DockPanel>
 <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE2EA" BorderThickness="0,0,0,1" Padding="12,9"><DockPanel>
 <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image x:Name="HeaderLogo" Width="26" Height="26" Margin="0,0,6,0"/><TextBlock Text="Editor PDF" FontSize="19" FontWeight="SemiBold" Margin="2,0,9,0"/><Button Content="_Abrir" Click="OpenClick" ToolTip="Abrir PDF · Ctrl+O"/><Button Content="_Unir" Click="AppendClick" ToolTip="Unir o añadir PDF"/><Button Content="Guardar" Click="SaveClick" ToolTip="Guardar copia · Ctrl+Mayús+S"/><Button Content="Imprimir" Click="PrintClick" ToolTip="Ctrl+P"/><Button x:Name="UndoButton" Content="↶" Click="UndoClick" ToolTip="Deshacer · Ctrl+Z" AutomationProperties.Name="Deshacer" Style="{StaticResource CompactButton}"/><Button x:Name="RedoButton" Content="↷" Click="RedoClick" ToolTip="Rehacer · Ctrl+Y" AutomationProperties.Name="Rehacer" Style="{StaticResource CompactButton}"/></StackPanel>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="SearchBox" Width="116" Margin="3,0" VerticalContentAlignment="Center" AutomationProperties.Name="Buscar texto" ToolTip="Buscar · Ctrl+F" KeyDown="SearchKeys"/><Button Content="⌕" Click="SearchClick" Style="{StaticResource CompactButton}" ToolTip="Buscar" AutomationProperties.Name="Buscar"/><Button Content="−" Click="ZoomOut" Style="{StaticResource CompactButton}" AutomationProperties.Name="Reducir zoom"/><TextBlock x:Name="ZoomLabel" Text="100 %" Width="43" TextAlignment="Center"/><Button Content="+" Click="ZoomIn" Style="{StaticResource CompactButton}" AutomationProperties.Name="Ampliar zoom"/><Button Content="⛶" Click="FitClick" Style="{StaticResource CompactButton}" ToolTip="Ajustar página" AutomationProperties.Name="Ajustar página"/><Menu Background="White" VerticalAlignment="Center" Margin="5,0,0,0"><MenuItem Header="⚙" ToolTip="Configuración" Padding="8" AutomationProperties.Name="Configuración"><MenuItem Header="Activar menú del Explorador" Click="RegisterExplorerClick"/><MenuItem Header="Quitar menú del Explorador" Click="UnregisterExplorerClick"/><Separator/><MenuItem Header="Privacidad" Click="PrivacyClick"/></MenuItem></Menu></StackPanel>
 </DockPanel></Border>
 <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#EBEFF5" Height="39"><TabControl x:Name="DocumentTabs" SelectionChanged="DocumentSelected" Height="39" Padding="0" BorderThickness="0,0,0,1" BorderBrush="#CBD7E8" Background="#EBEFF5" ItemContainerStyle="{StaticResource DocumentTab}" AutomationProperties.Name="Documentos abiertos"><TabControl.ContentTemplate><DataTemplate><Border Height="0"/></DataTemplate></TabControl.ContentTemplate><TabControl.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource CompactButton}" MinWidth="20" MinHeight="20" Padding="1,0" Margin="7,0,0,0" Background="Transparent" BorderThickness="0" Click="CloseDocumentClick" ToolTip="Cerrar documento · Ctrl+W" AutomationProperties.Name="Cerrar documento"/><TextBlock Text="{Binding Header}" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/></DockPanel></DataTemplate></TabControl.ItemTemplate></TabControl></ScrollViewer>
 <StatusBar DockPanel.Dock="Bottom" Background="White" Padding="12,5"><StatusBarItem><TextBlock x:Name="Status" Text="Abre un PDF para comenzar." TextTrimming="CharacterEllipsis"/></StatusBarItem></StatusBar>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185" MinWidth="145"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="270" MinWidth="225"/></Grid.ColumnDefinitions>
 <DockPanel Grid.Column="0" Background="#EBEFF5"><TextBlock DockPanel.Dock="Top" Text="PÁGINAS" FontWeight="SemiBold" FontSize="11" Margin="12,10,0,5"/><WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,5"><local:ToolButton Content="Página en blanco" Icon="PagePlus" IconOnly="True" Style="{StaticResource CompactTool}" Click="BlankClick" ToolTip="Añadir página en blanco"/><local:ToolButton Content="Insertar PDF" Icon="Insert" IconOnly="True" Style="{StaticResource CompactTool}" Click="InsertVisualClick" ToolTip="Insertar páginas de PDF"/><local:ToolButton Content="Extraer páginas" Icon="Extract" IconOnly="True" Style="{StaticResource CompactTool}" Click="ExtractVisualClick" ToolTip="Extraer páginas"/><local:ToolButton Content="Dividir PDF" Icon="Split" IconOnly="True" Style="{StaticResource CompactTool}" Click="SplitVisualClick" ToolTip="Dividir PDF"/></WrapPanel><TextBox x:Name="RangeBox" Text="1" Visibility="Collapsed"/>
 <ListBox x:Name="PagesList" SelectionChanged="PageChanged" AllowDrop="True" PreviewMouseLeftButtonDown="ThumbnailMouseDown" PreviewMouseMove="ThumbnailMouseMove" DragOver="ThumbnailDragOver" Drop="ThumbnailDrop" DragLeave="ThumbnailDragLeave" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Páginas del documento"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,6"><Border Background="White" BorderBrush="#C3CEDD" BorderThickness="1"><Image Source="{Binding Image}" Width="120" MaxHeight="180" Stretch="Uniform"/></Border><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,5,0,1"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:ToolButton Content="Subir página" Icon="Up" IconOnly="True" Style="{StaticResource CompactTool}" Tag="up" Click="PageActionClick" ToolTip="Subir página"/><local:ToolButton Content="Bajar página" Icon="Down" IconOnly="True" Style="{StaticResource CompactTool}" Tag="down" Click="PageActionClick" ToolTip="Bajar página"/><local:ToolButton Content="Duplicar página" Icon="Duplicate" IconOnly="True" Style="{StaticResource CompactTool}" Tag="duplicate" Click="PageActionClick" ToolTip="Duplicar página"/><local:ToolButton Content="Girar página" Icon="Rotate" IconOnly="True" Style="{StaticResource CompactTool}" Tag="rotate" Click="PageActionClick" ToolTip="Girar página"/><local:ToolButton Content="Eliminar página" Icon="Delete" IconOnly="True" Style="{StaticResource CompactTool}" Tag="delete" Click="PageActionClick" ToolTip="Eliminar página"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
 <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DCE2EA"/>
 <Grid Grid.Column="2"><ScrollViewer x:Name="DocumentScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="DocumentMouseWheel"><Border x:Name="Paper" Background="White" Margin="25" HorizontalAlignment="Center" VerticalAlignment="Top"><Grid><Image x:Name="PageImage" Stretch="Fill" MouseLeftButtonDown="PageMouseDown" MouseLeftButtonUp="PageMouseUp"/><Canvas x:Name="Overlay"/></Grid></Border></ScrollViewer><TextBlock x:Name="EmptyHint" Text="Tus PDF, en tu equipo." FontSize="25" Foreground="#66768C" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
 <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#DCE2EA"/>
 <DockPanel x:Name="PropertiesPanel" Grid.Column="4" Background="White" Margin="0,1,0,0">
 <Border x:Name="EditableCopyPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF4D8" Padding="10" Margin="10,10,10,0"><StackPanel><TextBlock Text="Original de solo lectura" FontWeight="SemiBold"/><local:ToolButton x:Name="EditableCopyButton" Content="Crear copia editable" Icon="Duplicate" Click="EditableCopyClick" Margin="0,8,0,0" ToolTip="Quitar restricciones en una copia; el original queda intacto"/><local:ToolButton x:Name="RemoveSignaturesButton" Content="Quitar firmas (copia)" Icon="Duplicate" Click="EditableCopyClick" Margin="0,8,0,0"/></StackPanel></Border>
 <Button x:Name="FirmaPdfBanner" DockPanel.Dock="Bottom" Click="FirmaPdfClick" ToolTip="Firmar documentos con certificado digital · Microsoft Store" AutomationProperties.Name="¿Quieres firmar tus PDF? Prueba FirmaPDF en Microsoft Store" Background="#EDF3FC" BorderBrush="#CBDAF0" Padding="12,11" FontSize="12" Margin="14" HorizontalContentAlignment="Stretch">
  <StackPanel><TextBlock Text="¿Quieres firmar tus PDF?" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="Prueba FirmaPDF ↗" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/></StackPanel>
 </Button>
 <TabControl x:Name="ModeTabs" SelectionChanged="ModeChanged" Margin="10,12,10,0" Padding="0" BorderThickness="0" Background="White" AutomationProperties.Name="Herramientas de edición">
 <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="12,8"/><Setter Property="MinWidth" Value="105"/><Setter Property="FontSize" Value="13"/></Style></TabControl.Resources>
 <TabItem x:Name="EditMode" Header="_Editar" IsSelected="True" AutomationProperties.Name="Editar"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,10,6,4">
 <StackPanel x:Name="EditPanel"><StackPanel Orientation="Horizontal"><local:ToolButton Content="Añadir texto" Icon="Text" IconOnly="True" Style="{StaticResource CompactTool}" Click="AddTextClick" ToolTip="Añadir texto"/><local:ToolButton Content="Añadir imagen" Icon="Image" IconOnly="True" Style="{StaticResource CompactTool}" Click="AddImageClick" ToolTip="Añadir imagen"/><local:ToolButton Content="Aplicar texto" Icon="Check" IconOnly="True" Style="{StaticResource CompactTool}" Click="ApplyTextClick" ToolTip="Aplicar texto"/><local:ToolButton Content="Editar párrafo" Icon="Paragraph" IconOnly="True" Style="{StaticResource CompactTool}" Click="EditParagraphClick" ToolTip="Seleccionar y editar párrafo"/></StackPanel>
 <Label Content="_Objeto" Target="{Binding ElementName=ObjectsList}"/><ListBox x:Name="ObjectsList" Height="125" SelectionChanged="ObjectChanged" DisplayMemberPath="Label" AutomationProperties.Name="Objetos editables"/>
 <Label Content="_Texto" Target="{Binding ElementName=TextValue}"/><TextBox x:Name="TextValue" MinHeight="60" TextWrapping="Wrap"/>
 <TextBlock x:Name="FontLabel" TextWrapping="Wrap" FontSize="11" Foreground="#69798E"/>
 <Label Content="Fuente" Target="{Binding ElementName=FontChoice}"/><ComboBox x:Name="FontChoice" Margin="0,3,0,7"/><StackPanel Orientation="Horizontal"><ToggleButton x:Name="BoldChoice" Content="B" FontWeight="Bold" Style="{StaticResource TextStyleToggle}" ToolTip="Negrita" AutomationProperties.Name="Negrita"/><ToggleButton x:Name="ItalicChoice" Content="I" FontStyle="Italic" Style="{StaticResource TextStyleToggle}" ToolTip="Cursiva" AutomationProperties.Name="Cursiva"/></StackPanel>
 <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Label Content="Tamaño (pt)" Target="{Binding ElementName=FontSizeValue}"/><Label Grid.Column="1" Content="Color"/><DockPanel Grid.Row="1"><StackPanel DockPanel.Dock="Right" Orientation="Vertical"><RepeatButton Content="⌃" Width="18" Height="14" MinHeight="14" Padding="0" Margin="0" Delay="350" Interval="80" Click="FontSizeUp" ToolTip="Aumentar tamaño" AutomationProperties.Name="Aumentar tamaño de letra"/><RepeatButton Content="⌄" Width="18" Height="14" MinHeight="14" Padding="0" Margin="0" Delay="350" Interval="80" Click="FontSizeDown" ToolTip="Reducir tamaño" AutomationProperties.Name="Reducir tamaño de letra"/></StackPanel><TextBox x:Name="FontSizeValue" Margin="0,3,3,8" AutomationProperties.Name="Tamaño del texto"/></DockPanel><Button x:Name="ColorPickerButton" Grid.Row="1" Grid.Column="1" Click="PickColorClick" Margin="0,3,0,8" Style="{StaticResource CompactButton}" ToolTip="Elegir color" AutomationProperties.Name="Elegir color de texto"><Border x:Name="ColorSwatch" Width="52" Height="18" BorderBrush="#AAB5C4" BorderThickness="1" Background="Black"/></Button><TextBox x:Name="ColorValue" Visibility="Collapsed" Text="#000000"/></Grid><local:ToolButton x:Name="ApplyStyleButton" Content="Aplicar estilo" Icon="Text" IconOnly="True" Style="{StaticResource CompactTool}" Click="ApplyStyleClick" HorizontalAlignment="Left" ToolTip="Aplicar estilo"/>
 <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
 <Label Content="_X (pt)" Target="{Binding ElementName=XValue}"/><Label Grid.Column="1" Content="_Y (pt)" Target="{Binding ElementName=YValue}"/><TextBox Grid.Row="1" x:Name="XValue" Margin="0,3,5,8"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="YValue"/>
 <Label Grid.Row="2" Content="_Ancho (pt)" Target="{Binding ElementName=WValue}"/><Label Grid.Row="2" Grid.Column="1" Content="A_lto (pt)" Target="{Binding ElementName=HValue}"/><TextBox Grid.Row="3" x:Name="WValue" Margin="0,3,5,8"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="HValue"/></Grid>
 <StackPanel Orientation="Horizontal"><local:ToolButton Content="Aplicar posición" Icon="Position" IconOnly="True" Style="{StaticResource CompactTool}" Click="ApplyPositionClick" ToolTip="Aplicar posición"/><local:ToolButton Content="Eliminar objeto" Icon="Delete" IconOnly="True" Style="{StaticResource CompactTool}" Click="DeleteObjectClick" ToolTip="Eliminar objeto"/></StackPanel>
 </StackPanel>
 </StackPanel></ScrollViewer></TabItem></TabControl></DockPanel>
 </Grid>
</DockPanel></Window>
