<Window x:Class="EditorPdf.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EditorPdf.App" Title="Editor PDF" Width="1280" Height="850" MinWidth="920" MinHeight="620" Background="#F3F5F8" Foreground="#203047" FontSize="13" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="KeysPressed" Closing="WindowClosing">

<DockPanel>
 <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE2EA" BorderThickness="0,0,0,1" Padding="12,9"><DockPanel>
 <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image x:Name="HeaderLogo" Width="26" Height="26" Margin="0,0,6,0"/><TextBlock Text="Editor PDF" FontSize="19" FontWeight="SemiBold" Margin="2,0,9,0"/><local:ToolButton Icon="FolderOpen" IconOnly="True" IconSize="23" Content="_Abrir" Style="{StaticResource MainTool}" Click="OpenClick" ToolTip="{local:Loc 'Abrir PDF · Ctrl+O'}"/><local:ToolButton Icon="Save" IconOnly="True" IconSize="23" Content="Guardar" Style="{StaticResource MainTool}" Click="SaveClick" ToolTip="{local:Loc 'Guardar copia · Ctrl+Mayús+S'}"/><local:ToolButton Icon="Print" IconOnly="True" IconSize="23" Content="Imprimir" Style="{StaticResource MainTool}" Click="PrintClick" ToolTip="{local:Loc 'Imprimir · Ctrl+P'}"/><local:ToolButton Icon="Merge" IconOnly="True" IconSize="23" Content="_Unir" Style="{StaticResource MainTool}" Click="AppendClick" ToolTip="{local:Loc 'Unir o añadir PDF'}"/><local:ToolButton x:Name="UndoButton" Icon="Undo" IconOnly="True" IconSize="23" Content="Deshacer" Click="UndoClick" ToolTip="{local:Loc 'Deshacer · Ctrl+Z'}" AutomationProperties.Name="{local:Loc 'Deshacer'}" Style="{StaticResource MainTool}"/><local:ToolButton x:Name="RedoButton" Icon="Redo" IconOnly="True" IconSize="23" Content="Rehacer" Click="RedoClick" ToolTip="{local:Loc 'Rehacer · Ctrl+Y'}" AutomationProperties.Name="{local:Loc 'Rehacer'}" Style="{StaticResource MainTool}"/></StackPanel>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="#EDF4FD" BorderBrush="#D3E1F4" BorderThickness="1" CornerRadius="8" Margin="3" Padding="4,0"><DockPanel><local:ToolButton DockPanel.Dock="Right" Icon="Search" IconOnly="True" IconSize="20" Content="Buscar" Click="SearchClick" Style="{StaticResource MainTool}" MinHeight="34" Margin="0" ToolTip="{local:Loc 'Buscar'}"/><TextBox TextChanged="SearchChanged" x:Name="SearchBox" Width="85" Margin="3,0" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Loc 'Buscar texto'}" ToolTip="{local:Loc 'Buscar · Ctrl+F'}" KeyDown="SearchKeys" BorderThickness="0"/></DockPanel></Border><TextBlock x:Name="SearchCount" Margin="2,0"/><local:ToolButton x:Name="SearchBack" Visibility="Collapsed" Icon="Up" IconOnly="True" Content="Resultado anterior" Click="SearchPrevious" Style="{StaticResource MainTool}" ToolTip="{local:Loc 'Resultado anterior'}"/><local:ToolButton x:Name="SearchNext" Visibility="Collapsed" Icon="Down" IconOnly="True" Content="Resultado siguiente" Click="SearchClick" Style="{StaticResource MainTool}" ToolTip="{local:Loc 'Resultado siguiente'}"/><Border Width="18"/><local:ToolButton Icon="Minus" IconOnly="True" IconSize="20" Content="Reducir zoom" Click="ZoomOut" Style="{StaticResource MainTool}" ToolTip="{local:Loc 'Reducir zoom'}"/><TextBlock x:Name="ZoomLabel" Text="100 %" Width="43" TextAlignment="Center"/><local:ToolButton Icon="Plus" IconOnly="True" IconSize="20" Content="Ampliar zoom" Click="ZoomIn" Style="{StaticResource MainTool}" ToolTip="{local:Loc 'Ampliar zoom'}"/><local:ToolButton Icon="Fit" IconOnly="True" IconSize="20" Content="Ajustar página" Click="FitClick" Style="{StaticResource MainTool}" ToolTip="{local:Loc 'Ajustar página'}"/><Menu Background="White" VerticalAlignment="Center" Margin="5,0,0,0"><MenuItem Header="⚙" ToolTip="{local:Loc 'Configuración'}" Padding="8" AutomationProperties.Name="{local:Loc 'Configuración'}"><MenuItem Header="{local:Loc 'Ac