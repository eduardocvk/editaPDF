  <StackPanel><TextBlock Text="{local:Loc '¿Quieres firmar tus PDF?'}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{local:Loc 'Prueba FirmaPDF ↗'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/></StackPanel>
 </Button>
