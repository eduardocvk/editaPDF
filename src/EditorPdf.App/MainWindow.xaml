<Window x:Class="EditorPdf.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EditorPdf.App" Title="Editor PDF" Width="1280" Height="850" MinWidth="920" MinHeight="620" Background="#F3F5F8" Foreground="#203047" FontSize="13" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="KeysPressed" Closing="WindowClosing">

<DockPanel>
 <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE2EA" BorderThickness="0,0,0,1" Padding="12,9"><DockPanel>
 <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image x:Name="HeaderLogo" Width="30" Height="30" Margin="0,0,9,0"/><TextBlock Text="Editor PDF" FontSize="21" FontWeight="SemiBold" Margin="4,0,20,0"/><Button Content="_Abrir" Click="OpenClick" ToolTip="Abrir PDF · Ctrl+O"/><Button Content="_Unir / añadir" Click="AppendClick"/><Button Content="Guardar _copia" Click="SaveClick" ToolTip="Ctrl+Mayús+S"/><Button Content="Imprimir" Click="PrintClick" ToolTip="Ctrl+P"/></StackPanel>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="UndoButton" Content="↶" Click="UndoClick" ToolTip="Deshacer · Ctrl+Z" AutomationProperties.Name="Deshacer"/><Button x:Name="RedoButton" Content="↷" Click="RedoClick" ToolTip="Rehacer · Ctrl+Y" AutomationProperties.Name="Rehacer"/><Menu Background="White" VerticalAlignment="Center"><MenuItem Header="_Configuración" Padding="8"><MenuItem Header="Activar menú del Explorador" Click="RegisterExplorerClick"/><MenuItem Header="Quitar menú del Explorador" Click="UnregisterExplorerClick"/><Separator/><MenuItem Header="Privacidad" Click="PrivacyClick"/></MenuItem></Menu></StackPanel>
 </DockPanel></Border>
 <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#EBEFF5"><TabControl x:Name="DocumentTabs" SelectionChanged="DocumentSelected" Height="42" Padding="0" BorderThickness="0" Background="#EBEFF5" AutomationProperties.Name="Documentos abiertos"><TabControl.ContentTemplate><DataTemplate><Border Height="0"/></DataTemplate></TabControl.ContentTemplate><TabControl.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="4,0" MinHeight="20" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Click="CloseDocumentClick" ToolTip="Cerrar documento · Ctrl+W" AutomationProperties.Name="Cerrar documento"/><TextBlock Text="{Binding Header}" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/></DockPanel></DataTemplate></TabControl.ItemTemplate></TabControl></ScrollViewer>
 <Border DockPanel.Dock="Top" Background="White" Padding="14,7"><DockPanel>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="SearchBox" Width="185" Margin="3" AutomationProperties.Name="Buscar texto" ToolTip="Buscar · Ctrl+F" KeyDown="SearchKeys"/><Button Content="Buscar" Click="SearchClick"/><Button Content="−" Click="ZoomOut" AutomationProperties.Name="Reducir zoom"/><TextBlock x:Name="ZoomLabel" Text="100 %" Width="48" TextAlignment="Center"/><Button Content="+" Click="ZoomIn" AutomationProperties.Name="Ampliar zoom"/><Button Content="Ajustar" Click="FitClick"/></StackPanel>
 </DockPanel></Border>
 <StatusBar DockPanel.Dock="Bottom" Background="White" Padding="12,5"><StatusBarItem><TextBlock x:Name="Status" Text="Abre un PDF para comenzar." TextTrimming="CharacterEllipsis"/></StatusBarItem></StatusBar>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185" MinWidth="145"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="270" MinWidth="225"/></Grid.ColumnDefinitions>
 <DockPanel Grid.Column="0" Background="#EBEFF5"><TextBlock DockPanel.Dock="Top" Text="PÁGINAS" FontWeight="SemiBold" FontSize="11" Margin="18,16,0,10"/>
 <ListBox x:Name="PagesList" SelectionChanged="PageChanged" AllowDrop="True" PreviewMouseLeftButtonDown="ThumbnailMouseDown" PreviewMouseMove="ThumbnailMouseMove" DragOver="ThumbnailDragOver" Drop="ThumbnailDrop" DragLeave="ThumbnailDragLeave" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Páginas del documento"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12,8"><Border Background="White" BorderBrush="#C3CEDD" BorderThickness="1"><Image Source="{Binding Image}" Width="120" MaxHeight="180" Stretch="Uniform"/></Border><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
 <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DCE2EA"/>
 <Grid Grid.Column="2"><ScrollViewer x:Name="DocumentScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Border x:Name="Paper" Background="White" Margin="25" HorizontalAlignment="Center" VerticalAlignment="Top"><Grid><Image x:Name="PageImage" Stretch="Fill" MouseLeftButtonDown="PageMouseDown" MouseLeftButtonUp="PageMouseUp"/><Canvas x:Name="Overlay"/></Grid></Border></ScrollViewer><TextBlock x:Name="EmptyHint" Text="Tus PDF, en tu equipo." FontSize="25" Foreground="#66768C" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
 <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#DCE2EA"/>
 <DockPanel x:Name="PropertiesPanel" Grid.Column="4" Background="White" Margin="0,1,0,0">
 <Border x:Name="EditableCopyPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF4D8" Padding="10" Margin="10,10,10,0"><StackPanel><TextBlock Text="Original de solo lectura" FontWeight="SemiBold"/><local:ToolButton x:Name="EditableCopyButton" Content="Crear copia editable" Icon="Duplicate" Click="EditableCopyClick" Margin="0,8,0,0" ToolTip="Quitar restricciones en una copia; el original queda intacto"/><local:ToolButton x:Name="RemoveSignaturesButton" Content="Quitar firmas (copia)" Icon="Duplicate" Click="EditableCopyClick" Margin="0,8,0,0"/></StackPanel></Border>
 <Button x:Name="FirmaPdfBanner" DockPanel.Dock="Bottom" Click="FirmaPdfClick" ToolTip="Firmar documentos con certificado digital · Microsoft Store" AutomationProperties.Name="¿Quieres firmar tus PDF? Prueba FirmaPDF en Microsoft Store" Background="#EDF3FC" BorderBrush="#CBDAF0" Padding="12,11" FontSize="12" Margin="14" HorizontalContentAlignment="Stretch">
  <StackPanel><TextBlock Text="¿Quieres firmar tus PDF?" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="Prueba FirmaPDF ↗" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/></StackPanel>
 </Button>
 <TabControl x:Name="ModeTabs" SelectionChanged="ModeChanged" Margin="10,12,10,0" Padding="0" BorderThickness="0" Background="White" AutomationProperties.Name="Herramientas del documento">
 <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="12,8"/><Setter Property="MinWidth" Value="105"/><Setter Property="FontSize" Value="13"/></Style></TabControl.Resources>
 <TabItem x:Name="OrganizeMode" Header="_Organizar" IsSelected="True" AutomationProperties.Name="Organizar"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,16,6,4">
 <StackPanel x:Name="OrganizePanel"><WrapPanel><local:ToolButton Content="En blanco" Icon="PagePlus" Click="BlankClick"/><local:ToolButton Content="Duplicar" Icon="Duplicate" Click="DuplicateClick"/><local:ToolButton Content="Girar" Icon="Rotate" Click="RotateClick"/><local:ToolButton Content="Eliminar" Icon="Delete" Click="DeletePageClick"/></WrapPanel><WrapPanel><local:ToolButton Content="Subir" Icon="Up" Click="MoveUpClick"/><local:ToolButton Content="Bajar" Icon="Down" Click="MoveDownClick"/></WrapPanel><TextBox x:Name="RangeBox" Text="1" Visibility="Collapsed"/><WrapPanel><local:ToolButton Content="Extraer" Icon="Extract" Click="ExtractVisualClick"/><local:ToolButton Content="Dividir" Icon="Split" Click="SplitVisualClick"/><local:ToolButton Content="Insertar PDF" Icon="Insert" Click="InsertVisualClick"/></WrapPanel></StackPanel>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem x:Name="EditMode" Header="_Editar" AutomationProperties.Name="Editar"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,16,6,4">
 <StackPanel x:Name="EditPanel"><WrapPanel><local:ToolButton Content="Añadir texto" Icon="Text" Click="AddTextClick"/><local:ToolButton Content="Imagen" Icon="Image" Click="AddImageClick"/></WrapPanel>
 <Label Content="_Objeto" Target="{Binding ElementName=ObjectsList}"/><ListBox x:Name="ObjectsList" Height="125" SelectionChanged="ObjectChanged" DisplayMemberPath="Label" AutomationProperties.Name="Objetos editables"/>
 <Label Content="_Texto" Target="{Binding ElementName=TextValue}"/><TextBox x:Name="TextValue" MinHeight="60" TextWrapping="Wrap"/>
 <TextBlock x:Name="FontLabel" TextWrapping="Wrap" FontSize="11" Foreground="#69798E"/>
 <CheckBox x:Name="SubstituteFont" Content="Sustituir fuente original" Margin="0,8"/><Label Content="Fuente incluida" Target="{Binding ElementName=FontChoice}"/><ComboBox x:Name="FontChoice" SelectionChanged="FontChoiceChanged" Margin="0,3,0,7"/><WrapPanel><CheckBox x:Name="BoldChoice" Content="Negrita" Margin="0,0,14,7"/><CheckBox x:Name="ItalicChoice" Content="Cursiva" Margin="0,0,0,7"/></WrapPanel><local:ToolButton Content="Aplicar texto" Icon="Check" Click="ApplyTextClick" HorizontalAlignment="Left"/>
 <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Label Content="Tamaño (pt)" Target="{Binding ElementName=FontSizeValue}"/><Label Grid.Column="1" Content="Color" Target="{Binding ElementName=ColorValue}"/><TextBox x:Name="FontSizeValue" Grid.Row="1" Margin="0,3,5,8" AutomationProperties.Name="Tamaño del texto"/><TextBox x:Name="ColorValue" Grid.Row="1" Grid.Column="1" ToolTip="#RRGGBB" AutomationProperties.Name="Color del texto"/></Grid><local:ToolButton x:Name="ApplyStyleButton" Content="Aplicar estilo" Icon="Text" Click="ApplyStyleClick" HorizontalAlignment="Left"/>
 <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
 <Label Content="_X (pt)" Target="{Binding ElementName=XValue}"/><Label Grid.Column="1" Content="_Y (pt)" Target="{Binding ElementName=YValue}"/><TextBox Grid.Row="1" x:Name="XValue" Margin="0,3,5,8"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="YValue"/>
 <Label Grid.Row="2" Content="_Ancho (pt)" Target="{Binding ElementName=WValue}"/><Label Grid.Row="2" Grid.Column="1" Content="A_lto (pt)" Target="{Binding ElementName=HValue}"/><TextBox Grid.Row="3" x:Name="WValue" Margin="0,3,5,8"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="HValue"/></Grid>
 <WrapPanel><local:ToolButton Content="Aplicar posición" Icon="Position" Click="ApplyPositionClick"/><local:ToolButton Content="Eliminar objeto" Icon="Delete" Click="DeleteObjectClick"/></WrapPanel>
 </StackPanel>
 </StackPanel></ScrollViewer></TabItem></TabControl></DockPanel>
 </Grid>
</DockPanel></Window>
