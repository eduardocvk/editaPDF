 <ListBox x:Name="PagesList" SelectionMode="Extended" PreviewMouseLeftButtonUp="ThumbnailMouseUp" PreviewMouseRightButtonDown="PagesRightClick" ContextMenuOpening="PagesContextOpening" SelectionChanged="PageChanged" AllowDrop="True" PreviewMouseLeftButtonDown="ThumbnailMouseDown" PreviewMouseMove="ThumbnailMouseMove" DragOver="ThumbnailDragOver" Drop="ThumbnailDrop" DragLeave="ThumbnailDragLeave" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{local:Loc 'Páginas del documento'}"><ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,6"><Border HorizontalAlignment="Center" Background="White" BorderBrush="#C3CEDD" BorderThickness="1"><Image Source="{Binding Image}" Width="120" MaxHeight="180" Stretch="Uniform"/></Border><DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Label}" Margin="6,0,3,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><local:ToolButton Content="Subir página" Icon="Up" IconOnly="True" Style="{StaticResource PageAction}" Tag="up" Click="PageActionClick" ToolTip="{local:Loc 'Subir página'}"/><local:ToolButton Content="Bajar página" Icon="Down" IconOnly="True" Style="{StaticResource PageAction}" Tag="down" Click="PageActionClick" ToolTip="{local:Loc 'Bajar página'}"/><local:ToolButton Content="Duplicar página" Icon="Duplicate" IconOnly="True" Style="{StaticResource PageAction}" Tag="duplicate" Click="PageActionClick" ToolTip="{local:Loc 'Duplicar página'}"/><local:ToolButton Content="Girar página" Icon="Rotate" IconOnly="True" Style="{StaticResource PageAction}" Tag="rotate" Click="PageActionClick" ToolTip="{local:Loc 'Girar página'}"/><local:ToolButton Content="Eliminar página" Icon="Delete" IconOnly="True" Style="{StaticResource PageAction}" Tag="delete" Click="PageActionClick" ToolTip="{local:Loc 'Eliminar página'}"/></StackPanel></DockPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
 <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DCE2EA"/>
