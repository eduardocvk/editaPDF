 <Label Content="{local:Loc 'Fuente'}" Target="{Binding ElementName=FontChoice}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="FontChoice" Margin="0,3,0,7"/><ToggleButton x:Name="BoldChoice" Grid.Column="1" Margin="3,0,2,4" Content="B" FontWeight="Bold" Style="{StaticResource TextStyleToggle}" ToolTip="{local:Loc 'Negrita'}" AutomationProperties.Name="{local:Loc 'Negrita'}"/><ToggleButton x:Name="ItalicChoice" Grid.Column="2" Margin="1,0,0,4" Content="I" FontStyle="Italic" Style="{StaticResource TextStyleToggle}" ToolTip="{local:Loc 'Cursiva'}" AutomationProperties.Name="{local:Loc 'Cursiva'}"/></Grid>
 <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Label Content="{local:Loc 'Tamaño (pt)'}" Target="{Binding ElementName=FontSizeValue}"/><Label Grid.Column="1" Content="{local:Loc 'Color'}"/><DockPanel Grid.Row="1"><StackPanel DockPanel.Dock="Right" Orientation="Vertical"><RepeatButton Content="⌃" Width="18" Height="14" MinHeight="14" Padding="0" Margin="0" Delay="350" Interval="80" Click="FontSizeUp" ToolTip="{local:Loc 'Aumentar tamaño'}" AutomationProperties.Name="{local:Loc 'Aumentar tamaño de letra'}"/><RepeatButton Content="⌄" Width="18" Height="14" MinHeight="14" Padding="0" Margin="0" Delay="350" Interval="80" Click="FontSizeDown" ToolTip="{local:Loc 'Reducir tamaño'}" AutomationProperties.Name="{local:Loc 'Reducir tamaño de letra'}"/></StackPanel><TextBox x:Name="FontSizeValue" Margin="0,3,3,8" AutomationProperties.Name="{local:Loc 'Tamaño del texto'}"/></DockPanel><Button x:Name="ColorPickerButton" Grid.Row="1" Grid.Column="1" Click="PickColorClick" Margin="0,3,0,8" Style="{StaticResource CompactButton}" ToolTip="{local:Loc 'Elegir color'}" AutomationProperties.Name="{local:Loc 'Elegir color de texto'}"><Border x:Name="ColorSwatch" Width="52" Height="18" BorderBrush="#AAB5C4" BorderThickness="1" Background="Black"/></Button><TextBox x:Name="ColorValue" Visibility="Collapsed" Text="#000000"/><local:ToolButton x:Name="ApplyStyleButton" Content="Aplicar estilo" Icon="Style" IconOnly="True" Style="{StaticResource CompactTool}" Click="ApplyStyleClick" Grid.Row="1" Grid.Column="2" Margin="2,3,0,8" ToolTip="{local:Loc 'Aplicar estilo'}"/></Grid>
