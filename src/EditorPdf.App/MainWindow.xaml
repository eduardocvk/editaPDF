 </DockPanel></Border>
 <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#EBEFF5" Height="39"><TabControl x:Name="DocumentTabs" AllowDrop="True" PreviewDragOver="DocumentTabDragOver" PreviewDrop="DocumentTabDrop" SelectionChanged="DocumentSelected" Height="39" Padding="0" BorderThickness="0,0,0,1" BorderBrush="#CBD7E8" Background="#EBEFF5" ItemContainerStyle="{StaticResource DocumentTab}" AutomationProperties.Name="{local:Loc 'Documentos abiertos'}"><TabControl.Template><ControlTemplate TargetType="TabControl"><Border BorderBrush="#CBD7E8" BorderThickness="0,0,0,1"><ItemsPresenter HorizontalAlignment="Left"/></Border></ControlTemplate></TabControl.Template><TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></TabControl.ItemsPanel><TabControl.ContentTemplate><DataTemplate><Border Height="0"/></DataTemplate></TabControl.ContentTemplate><TabControl.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource CompactButton}" MinWidth="20" MinHeight="20" Padding="1,0" Margin="7,0,0,0" Background="Transparent" BorderThickness="0" Click="CloseDocumentClick" ToolTip="{local:Loc 'Cerrar documento · Ctrl+W'}" AutomationProperties.Name="{local:Loc 'Cerrar documento'}"/><TextBlock Text="{Binding Header}" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/></DockPanel></DataTemplate></TabControl.ItemTemplate></TabControl></ScrollViewer>
