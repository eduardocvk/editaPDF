<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EditorPdf.App">
 <SolidColorBrush x:Key="Accent" Color="#235EBC"/>
 <Style TargetType="Button"><Setter Property="Padding" Value="11,6"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CAD3DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="32"/></Style>
 <Style TargetType="{x:Type local:ToolButton}" BasedOn="{StaticResource {x:Type Button}}"/>
 <Style x:Key="MainTool" TargetType="{x:Type local:ToolButton}" BasedOn="{StaticResource {x:Type local:ToolButton}}">
  <Setter Property="MinHeight" Value="42"/><Setter Property="MinWidth" Value="38"/><Setter Property="Padding" Value="8,5"/>
  <Setter Property="Foreground" Value="#214F88"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ToolButton}">
   <Border x:Name="Surface" Background="#EDF4FD" BorderBrush="#D3E1F4" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DBEAFE"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#BFDBFE"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#235EBC"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="1"/><Setter Property="MinWidth" Value="27"/><Setter Property="MinHeight" Value="27"/><Setter Property="BorderBrush" Value="#C7D4E5"/></Style>
 <Style x:Key="CompactTool" TargetType="{x:Type local:ToolButton}" BasedOn="{StaticResource {x:Type local:ToolButton}}"><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="1"/><Setter Property="MinWidth" Value="27"/><Setter Property="MinHeight" Value="27"/></Style>
 <Style x:Key="PageAction" TargetType="{x:Type local:ToolButton}" BasedOn="{StaticResource CompactTool}"><Setter Property="MinWidth" Value="20"/><Setter Property="MinHeight" Value="22"/><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0"/></Style>
 <Style x:Key="TextStyleToggle" TargetType="ToggleButton"><Setter Property="Width" Value="31"/><Setter Property="Height" Value="29"/><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="1,0,3,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CAD3DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#DDEAFF"/><Setter Property="BorderBrush" Value="#235EBC"/><Setter Property="Foreground" Value="#164A9B"/></Trigger></Style.Triggers></Style>
 <Style x:Key="DocumentTab" TargetType="TabItem"><Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="4,1,0,0"/><Setter Property="Background" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="#CFD9E6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="White"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#85A7DB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="7,6"/><Setter Property="Margin" Value="0,3,0,8"/><Setter Property="BorderBrush" Value="#CAD3DF"/></Style>
 <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style TargetType="Label"><Setter Property="Padding" Value="0,5,0,0"/></Style>
</ResourceDictionary>
